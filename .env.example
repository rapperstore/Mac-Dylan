# ─────────────────────────────────────────────
# Mac Dylan — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# ─────────────────────────────────────────────

# Flask
SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=your_admin_password_here

# Stripe — get from dashboard.stripe.com → Developers → API Keys
# Test keys start with sk_test_ and pk_test_
# Live keys start with sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Stripe Webhook — get from dashboard.stripe.com → Developers → Webhooks
# After adding endpoint /payments/webhook, click Reveal under Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Printful — get from printful.com → Dashboard → API → Generate Token
PRINTFUL_API_KEY=your_printful_api_key_here

# ConvertKit — Form ID (yours is 9292507)
CONVERTKIT_FORM_ID=9292507

# Database
# Leave blank locally (uses SQLite)
# Railway sets this automatically in production
DATABASE_URL=

# Domain — change after Railway deploy
DOMAIN=http://localhost:5000
